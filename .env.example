# Never commit real secrets. Copy to .env.local (gitignored).
# Netlify DB (Neon Postgres) — pooled connection string goes here when wiring Phase 1.
# Provided project ref: cold-meadow-09162217
DATABASE_URL=
NETLIFY_DATABASE_URL=
# App (portable, host-agnostic)
VITE_APP_CLIENT_CODE=ABC
VITE_APP_BE_YEAR=2569
# Local API base when Netlify Functions exist (empty = mock mode)
VITE_API_BASE=
# Admin operation base (empty = same as VITE_API_BASE; set to :8788 when split)
VITE_ADMIN_API_BASE=
# Vendor recall (remembered last/frequent items). Set to "off" to disable entirely.
VITE_FEATURE_VENDOR_MEMORY=on
# Pilot API server (host-agnostic Node, see docs/API.md)
PORT=8787
# Isolated admin operation (separate port + tw_admin cookie, 12h sessions)
ADMIN_PORT=8788
# Optional: comma-separated IPs allowed to reach the admin operation (empty = allow all localhost)
ADMIN_IP_ALLOWLIST=
# Comma-separated browser origins allowed to call the API with credentials.
# Empty = reflect the request origin (dev only). Set in production, e.g.
# ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=
# Bootstrap super_admin for the admin operation (used by scripts/seed-admin.mjs)
ADMIN_EMAIL=
# Server-side encryption of vendor tax IDs (vendors.id_number_encrypted), AES-256-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ID_ENCRYPTION_KEY=
PILOT_TENANT=ABC
PILOT_BE_YEAR=2569
STORAGE_DIR=./storage
# Directory holding the server-side receipt fonts (Sarabun-*.ttf).
# Defaults to <cwd>/server/assets/fonts. Vercel ships it via vercel.json includeFiles.
FONTS_DIR=
PUBLIC_BASE_URL=http://localhost:5173
# Vercel: set VITE_API_BASE and VITE_ADMIN_API_BASE to the deployment origin
# before building (empty forces mock mode). Admin is mounted at /api/admin-op:
#   VITE_API_BASE=https://<project>.vercel.app
#   VITE_ADMIN_API_BASE=https://<project>.vercel.app/api/admin-op
CLIENT_DISPLAY=
# Cloudflare R2 — stores tenant signature/stamp images shown on WHT forms.
# Leave empty to disable uploads (the feature degrades gracefully).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vendor-esign
# LINE (final step — see docs/LINE.md; leave empty until then)
LIFF_ID=
LINE_CHANNEL_ID=
# Cron protection — Vercel Cron / scheduler sends "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Extra feature flags (server). Vendor receipts module stays on by default.
FEATURE_WHT=on

