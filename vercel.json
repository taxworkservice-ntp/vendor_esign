{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/entry.js": {
      "maxDuration": 30,
      "includeFiles": "server/assets/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/entry?__route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/vendor-link-expiry",
      "schedule": "0 3 * * *"
    }
  ]
}
