{
  "name": "taxwork-vendor-receipt-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json && node scripts/check-env.mjs && node scripts/check-design.mjs --strict && node scripts/check-react.mjs",
    "check:env": "node scripts/check-env.mjs",
    "lint:design": "node scripts/check-design.mjs",
    "check:react": "node scripts/check-react.mjs",
    "api:dev": "tsx watch server/src/index.ts",
    "api:start": "tsx server/src/index.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/verify.mjs",
    "db:live": "node scripts/db-live-check.mjs",
    "db:list": "tsx scripts/txn-list-check.ts",
    "db:seed": "node scripts/seed.mjs",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "pdf:preview": "tsx scripts/preview-receipt.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@hono/node-server": "^2.1.1",
    "@hono/vercel": "^1.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.454.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
